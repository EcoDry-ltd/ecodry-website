PORT=3000
SESSION_SECRET=replace-with-a-long-random-secret
ADMIN_USERNAME=ecodryadmin
ADMIN_PASSWORD=change-this-before-launch
SITE_URL=http://localhost:3000

# BACHS payment integration is not enabled until the provider supplies the
# correct merchant/API endpoint, credentials, callback verification method,
# and test/live environment details.
BACHS_MODE=manual
BACHS_API_BASE_URL=
BACHS_MERCHANT_ID=
BACHS_API_KEY=
BACHS_WEBHOOK_SECRET=

